# Get your API key from https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=your_api_key_here

# Sender identity for outreach drafts (python main.py outreach draft <id>).
# CAN-SPAM requires a truthful sender and a physical postal address in
# every commercial email — a PO Box or registered agent address works.
SENDER_NAME=Your Name
COMPANY_NAME=Arxon Solutions
POSTAL_ADDRESS=123 Main St, Suite 1, Savannah, GA 31401
# Optional hosted opt-out page; leave empty to use reply-to-unsubscribe only.
UNSUBSCRIBE_LINK=
